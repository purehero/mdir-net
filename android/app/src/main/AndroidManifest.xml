<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 세션 TCP 와 탐색 UDP -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Wi-Fi 스택은 자기 앞으로 오지 않은 패킷을 기본으로 걸러낸다. MulticastLock 을
      잡아야 브로드캐스트 알림이 올라온다. 이게 없으면 보내는 건 되는데 못 받는다
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 화면이 꺼져도 상대가 내 파일을 가져갈 수 있어야 하므로 리스너가 살아있어야 한다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 앱이 앞에 없을 때 들어온 연결의 승인을 알림으로 묻는다 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- LAN 전용이다. Wi-Fi 없는 기기에 설치될 이유가 없다 -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MDirNet">

        <!--
          폴더블은 접었다 펴는 것만으로 구성이 바뀌어 액티비티가 다시 만들어진다.
          시스템 폴더 선택창이 떠 있는 동안 그러면 결과가 유실되어, 폴더는 만들어졌는데
          목록에는 아무것도 안 들어오는 일이 생긴다. 화면 관련 변경은 직접 받는다
          (Compose 는 재생성 없이 새 구성으로 다시 그린다).

          launchMode 는 singleTask 대신 singleTop 이다. 알림을 눌러 이미 떠 있는
          화면으로 돌아오는 데는 singleTop 으로 충분하고(서비스가 SINGLE_TOP|CLEAR_TOP
          으로 부른다), singleTask 는 태스크가 재정렬될 때 결과 전달이 깨지는 조합이다
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MDirNet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          화면이 꺼져도 상대가 내 파일을 가져갈 수 있어야 하므로 리스너가 살아있어야 한다.
          API 34 부터 foregroundServiceType 선언이 필수다
        -->
        <service
            android:name=".service.MDirService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
